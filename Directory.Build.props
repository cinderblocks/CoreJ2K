<Project>
	<PropertyGroup>
		<Version>2.4.1.0</Version>
		<Product>CoreJ2K</Product>
		<Authors>Sjofn LLC</Authors>
		<Copyright>Copyright © 1999-2000 JJ2000 Partners.Copyright © 2007-2012 Jason S. Clary. Copyright © 2013-2018 Anders Gustafsson, Cureos AB. Copyright © Sjofn LLC 2024-2026. All rights reserved.</Copyright>
		<Company>Sjofn LLC</Company>
	</PropertyGroup>
	<PropertyGroup>
		<PackageVersion>2.4.1.0</PackageVersion>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/cinderblocks/CoreJ2K</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageTags>jpeg2000 j2k jpm jp2 codec skia image-processing wavelet-compression .NETStandard</PackageTags>
		<RepositoryUrl>https://github.com/cinderblocks/CoreJ2K</RepositoryUrl>
		<PackageIcon>CoreJ2K.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<RepositoryBranch>master</RepositoryBranch>
	</PropertyGroup>
	<!-- Shared build settings for all projects -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Nullable warnings are surfaced but not errors; fix incrementally -->
		<WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8621;CS8625;CS8629</WarningsNotAsErrors>
	</PropertyGroup>
	<!--
		SixLabors.ImageSharp is kept at 3.1.12: the versions that fix these advisories (4.1.2) need a Six Labors licence key to build in Release.
		They concern ICC profile parsing (GHSA-gwg2), TIFF/BigTIFF decoding and encoding (GHSA-wmxv, GHSA-j9gm, GHSA-jjfr) and histogram
		equalization (GHSA-j3p4), none of which CoreJ2K calls; an application that decodes untrusted images with ImageSharp is exposed to them
		all the same. Revisit when moving to ImageSharp 4.
	-->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
	</ItemGroup>
	<!-- Shared settings for all packable projects -->
	<PropertyGroup Condition="'$(IsPackable)' != 'false'">
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DefineConstants>$(DefineConstants);NETSTANDARD</DefineConstants>
	</PropertyGroup>
	<!-- Common pack content for all packable projects -->
	<ItemGroup Condition="'$(IsPackable)' != 'false'">
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
		<None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
		<None Include="$(MSBuildThisFileDirectory)CoreJ2K.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
